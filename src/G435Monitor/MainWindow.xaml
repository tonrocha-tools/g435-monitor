<ui:FluentWindow x:Class="G435Monitor.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="G435 Battery"
                 Icon="app.ico"
                 Width="420" Height="480"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="#1A222C"
                 BorderBrush="#1A222C"
                 BorderThickness="0"
                 Foreground="#F2F6FA"
                 FontFamily="Segoe UI">
    <Grid Background="#1A222C">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="G435 Battery"
                     Background="Transparent"
                     ButtonsBackground="{StaticResource G435TitleBarHoverBrush}"
                     Foreground="#F2F6FA"
                     ShowMaximize="False"
                     ShowMinimize="True"
                     ShowClose="True" />

        <Border Grid.Row="1"
                Margin="16,0,16,16"
                Padding="24"
                CornerRadius="18"
                Background="Transparent"
                BorderThickness="0">
            <StackPanel>
                <TextBlock Text="G435 LIGHTSPEED"
                           Foreground="#8FA3B8"
                           FontSize="12"
                           FontWeight="SemiBold" />

                <TextBlock x:Name="BatteryText"
                           Text="—"
                           Foreground="#F2F6FA"
                           FontSize="72"
                           FontWeight="Bold"
                           Margin="0,2,0,0">
                    <TextBlock.ToolTip>
                        <ToolTip>Percentual filtrado: variações de até 2% são ignoradas e o valor não sobe espontaneamente.</ToolTip>
                    </TextBlock.ToolTip>
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#4CC2FF"
                                          BlurRadius="26"
                                          ShadowDepth="0"
                                          Opacity="0.35" />
                    </TextBlock.Effect>
                </TextBlock>

                <ProgressBar x:Name="BatteryBar"
                             Height="10"
                             Minimum="0" Maximum="100" Value="0"
                             Margin="0,8,0,0"
                             BorderThickness="0" />

                <TextBlock x:Name="MillivoltsText"
                           Text="— mV"
                           Foreground="#C7D2DE"
                           FontSize="14"
                           Margin="0,12,0,0" />

                <TextBlock x:Name="RemainingText"
                           Text="Tempo estimado: —"
                           Foreground="#8FA3B8"
                           FontSize="12"
                           Margin="0,4,0,0" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Border x:Name="StatusPill"
                            CornerRadius="10"
                            Padding="10,4"
                            Background="#222A3440">
                        <TextBlock x:Name="StatusText"
                                   Text="Procurando o dongle..."
                                   Foreground="#8FA3B8"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <ui:Button x:Name="RefreshButton"
                               Content="Atualizar agora"
                               Appearance="Primary"
                               Click="RefreshButton_Click"
                               Padding="16,8" />
                    <ui:Button x:Name="SettingsButton"
                               Content="Configurações"
                               Appearance="Secondary"
                               Click="SettingsButton_Click"
                               Padding="16,8"
                               Margin="10,0,0,0" />
                </StackPanel>

                <TextBlock x:Name="UpdatedText"
                           Text="Última atualização: —"
                           Foreground="#6F8094"
                           FontSize="11"
                           Margin="0,16,0,0" />

                <TextBlock x:Name="HintText"
                           Text=""
                           Foreground="#8FA3B8"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Visibility="Collapsed" />

                <TextBlock Text="Percentual estimado por tensão · sem G HUB"
                           Foreground="#536273"
                           FontSize="10"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
