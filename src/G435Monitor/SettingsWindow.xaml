<ui:FluentWindow x:Class="G435Monitor.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Configurações"
                 Icon="app.ico"
                 Width="420" Height="410"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="#1A222C"
                 BorderBrush="#1A222C"
                 BorderThickness="0"
                 Foreground="#F2F6FA"
                 FontFamily="Segoe UI">
    <Grid Background="#1A222C">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Configurações"
                     Background="Transparent"
                     ButtonsBackground="{StaticResource G435TitleBarHoverBrush}"
                     Foreground="#F2F6FA"
                     ShowMaximize="False"
                     ShowMinimize="True"
                     ShowClose="True" />

        <Border Grid.Row="1"
                Margin="16,0,16,16"
                Padding="22"
                CornerRadius="16"
                Background="Transparent"
                BorderThickness="0">
            <StackPanel>
                <ui:ToggleSwitch x:Name="StartWithWindowsToggle"
                                 Content="Iniciar com o Windows"
                                 Margin="0,6,0,0" />

                <ui:ToggleSwitch x:Name="MinimizeToTrayToggle"
                                 Content="Minimizar para a bandeja ao fechar"
                                 Margin="0,16,0,0" />

                <TextBlock Text="Intervalo de atualização"
                           Foreground="#8FA3B8"
                           FontSize="12"
                           Margin="0,22,0,8" />

                <ComboBox x:Name="IntervalCombo"
                          Width="190"
                          HorizontalAlignment="Left">
                    <ComboBoxItem Content="5 minutos" Tag="5" />
                    <ComboBoxItem Content="10 minutos" Tag="10" />
                    <ComboBoxItem Content="15 minutos" Tag="15" />
                    <ComboBoxItem Content="30 minutos" Tag="30" />
                </ComboBox>

                <TextBlock Text="Mínimo de 5 min. Atualização manual: mínimo de 30 s."
                           Foreground="#6F8094"
                           FontSize="11"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,26,0,0">
                    <ui:Button Content="Cancelar"
                               Appearance="Secondary"
                               Click="Cancel_Click"
                               Padding="16,8"
                               Margin="0,0,10,0" />
                    <ui:Button Content="Salvar"
                               Appearance="Primary"
                               Click="Save_Click"
                               Padding="18,8" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
