<Application x:Class="G435Monitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Hover dos botões da barra de título. O fechar usa o vermelho
                 do Windows; os demais usam um véu branco suave. -->
            <SolidColorBrush x:Key="G435TitleBarHoverBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="PaletteRedBrush" Color="#C42B1C" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
